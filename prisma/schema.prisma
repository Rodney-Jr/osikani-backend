
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  phoneNumber String   @unique // WhatsApp ID
  name        String?
  onboarding  Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  // Relations
  profile     Profile?
  transactions Transaction[]
  goals       Goal[]
  reward      Reward?
  campaignLogs CampaignLog[]
}

model Profile {
  id          String @id @default(uuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id])
  businessType String? // e.g., "Market Trader", "Student"
  monthlyIncome Float?
  currency    String @default("GHS")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // "INCOME" or "EXPENSE"
  amount      Float
  category    String   // "Food", "Transport", "Stock"
  description String?
  date        DateTime @default(now())
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String   // "School Fees", "New Fridge"
  targetAmount Float
  currentAmount Float @default(0)
  deadline    DateTime?
}

// --- Gamification Engine ---

model GameModule {
  id          String   @id @default(uuid())
  title       String   
  rawContent  String   // Original text/content
  questions   String   // JSON blob of generated questions
  createdAt   DateTime @default(now())
}

model GameSession {
  id          String   @id @default(uuid())
  userId      String
  moduleId    String
  currentStep Int      @default(0)
  score       Int      @default(0)
  status      String   // "IN_PROGRESS", "COMPLETED"
  createdAt   DateTime @default(now())
}

model Reward {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  points      Int      @default(0)
  badges      String   // JSON array e.g., ["Saver Badge"]
}

// --- Broadcast & Ads Engine ---

model Organization {
  id          String     @id @default(uuid())
  name        String
  type        String     // "BANK", "FINTECH", "INSURANCE", "MFI"
  email       String     @unique
  password    String     // In production, hash this!
  status      String     @default("PENDING") // PENDING, APPROVED, REJECTED
  apiKey      String?    @unique
  campaigns   Campaign[]
  branding    String?    // JSON string for WhiteLabel config
  createdAt   DateTime   @default(now())
}

model Campaign {
  id              String     @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  title           String
  content         String
  status          String     // "DRAFT", "SCHEDULED", "ACTIVE", "COMPLETED"
  targetCriteria  String?    // JSON e.g. {"businessType": "Market Trader"}
  budget          Float      @default(0)
  spent           Float      @default(0)
  createdAt       DateTime   @default(now())
  
  logs            CampaignLog[]
}

model CampaignLog {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  status      String   // "SENT", "DELIVERED", "READ", "ENGAGED"
  interaction String?  // User's reply logic
  timestamp   DateTime @default(now())
}

